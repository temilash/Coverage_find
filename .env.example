# Copy to .env and fill in what you need. .env is gitignored: never commit it.
# Sample mode (python run.py --sample) needs none of these.

# --- Zetaris (full mode): the local Docker stack's web app; the client signs in and queries through it
ZETARIS_URL=                # e.g. http://localhost:3000
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_TIMEOUT=            # seconds per query (default 120)
ZETARIS_PLATFORM_DIR=       # where the zetaris-platform bundle lives (default ~/zetaris-platform; scripts/zetaris/compose.sh)

# --- Agents: NVIDIA Nemotron through Meterless Nightshift (the primary provider)
# Connect your NVIDIA key in Nightshift's Providers tab, not here. The token is Nightshift's local
# runtime token: set it, or point to Nightshift's proxy-token file (read at call time, never copied).
METERLESS_BASE_URL=         # default http://127.0.0.1:8088/v1 (Docker: http://host.docker.internal:8088/v1)
METERLESS_RUNTIME_TOKEN=
METERLESS_RUNTIME_TOKEN_FILE=   # e.g. <Nightshift state dir>/proxy-token (Windows: %LOCALAPPDATA%\ai.meterless.runtime\proxy-token)
METERLESS_FRESH_SCOPE=      # 1: a new meterless-scope on every call (default: one scope per run)
STRICT_MODEL=               # 1: reject an answer from a model that is not Nemotron
LLM_MODEL=                  # nvidia/nemotron-3.5-super-vl-120b-a12b (never meterless/auto)
LLM_MODEL_REASONING=        # nvidia/nemotron-3-ultra-550b-a55b (the critic)

# --- NVIDIA direct: only a labelled fallback when Nightshift is unreachable (optional)
LLM_BASE_URL=               # default https://integrate.api.nvidia.com/v1
LLM_API_KEY=                # an NVIDIA API key (never logged or printed); leave empty to use Nightshift only

# --- Meterless service (agent memory); python run.py starts it
MEMORY_URL=                 # default http://127.0.0.1:8100
MEMORY_PORT=                # the service's port (default 8100)
MEMORY_DIR=                 # where it stores its data (default data/meterless/)

# --- Data downloads (only to rebuild the data from scratch)
OPENCELLID_TOKEN=           # free account at https://opencellid.org
OFCOM_API_KEY=              # optional; the postcode-level Ofcom API is not used without it

# --- Modes (set by run.py --sample and scripts/record_examples.py; SAMPLE_MODE=true = run.py --sample)
SAMPLE_MODE=
RECORD_EXAMPLES=

# --- Screenshots (optional)
CHROME_PATH=                # a Chromium binary for scripts/*screenshots.py if Playwright's own is not installed
