# Copy to .env if you need any of these. .env is gitignored: never commit it.
# The app needs no keys; sample mode (python run.py --sample) needs nothing at all.

# --- Data build only (optional): the one download that needs a key. Without it, mast sites come from
# OpenStreetMap and the Ofcom register only. Free account at https://opencellid.org
OPENCELLID_TOKEN=

# --- Modes: SAMPLE_MODE=true is the same as python run.py --sample
SAMPLE_MODE=
